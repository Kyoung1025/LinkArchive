# Postgres (used by backend/shared Prisma schema, backend/api, backend/worker)
DATABASE_URL="postgresql://linkarchive:linkarchive@localhost:5432/linkarchive?schema=public"

# Redis (used by backend/api producer and backend/worker consumer)
REDIS_HOST=localhost
REDIS_PORT=6379

# API server
PORT=3000
LOG_LEVEL=info

# Worker (exposes its own /metrics endpoint for Prometheus to scrape per pod)
METRICS_PORT=9100
