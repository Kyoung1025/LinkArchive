{
  "name": "@linkarchive/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ worker process: consumes link-scrape jobs, fetches URLs, parses metadata, updates the DB, and retries with exponential backoff on failure.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@linkarchive/shared": "*",
    "bullmq": "^5.13.2",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "pino": "^9.4.0",
    "prom-client": "^15.1.3",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
